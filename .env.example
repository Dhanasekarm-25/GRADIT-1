# Database Configuration
# Supabase removed — The chatbot runs completely offline with a local 200-student database in lib/db/localData.ts

# Local LLM / Ollama settings (Optional fallback)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Security & App configuration
APP_ENV=development
JWT_SECRET=your-jwt-secret-placeholder
